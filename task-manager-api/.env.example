# Copie para .env (carregado automaticamente via python-dotenv). Não versione o .env.
SECRET_KEY=
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_URL=sqlite:///tasks.db
CORS_ORIGINS=*
TOKEN_MAX_AGE_SECONDS=3600
# Notificações por e-mail (desligadas se SMTP_HOST estiver vazio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
