# Copie para .env (não versionado) ou exporte no shell antes de rodar `python app.py`.
SECRET_KEY=
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
DATABASE_PATH=loja.db
CORS_ORIGINS=*
# Token exigido no header X-Admin-Token das rotas /admin/*. Vazio = rotas admin desabilitadas.
ADMIN_TOKEN=
# Senha do usuário admin@loja.com criado no seed. Vazio = senha aleatória.
SEED_ADMIN_PASSWORD=
